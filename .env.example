# Bu dosyanın bir KOPYASINI ".env" adıyla oluşturup değerleri oraya yazın.
# .env depoya girmez. Değerleri sohbete yazmayın.

# Google Cloud'dan indirilen OAuth dosyasının yolu (bkz. kurulum/youtube-api.md)
YOUTUBE_CLIENT_SECRET_FILE=client_secret.json

# Yetki verildikten sonra otomatik oluşan dosya (elle doldurmayın)
YOUTUBE_TOKEN_FILE=token.json

# Niş analizi için (isteğe bağlı) – sadece herkese açık verileri okur
YOUTUBE_API_KEY=
